{
  auto_https off
  admin off
  storage file_system /caddy-data
  servers {
    trusted_proxies static private_ranges
  }
}

:80 {
  @badhost not header_regexp Host ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$
  respond @badhost 404

  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Se suma al <meta> del renderer y el navegador aplica la interseccion: si
    # aqui falta 'unsafe-inline', bloquea el <style> del tema; si falta data:,
    # bloquea las imagenes incrustadas. Ambas cosas rompieron sitios.
    Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://player.vimeo.com; frame-ancestors 'none'; form-action 'self'; base-uri 'none'"
    -Server
  }

  # El HTML no lleva cache-control, asi que el navegador lo guarda por su cuenta
  # a partir de last-modified y sigue enseñando la publicacion anterior.
  @html path / *.html
  header @html Cache-Control "no-cache"
  @assets path /assets/*
  header @assets Cache-Control "public, max-age=31536000"

  handle /_f/* {
    reverse_proxy platform:3000
  }
  handle /_c/* {
    reverse_proxy platform:3000
  }
  handle {
    root * /data/hosts/{host}
    file_server
    encode zstd gzip
  }
  handle_errors {
    respond "Sitio no disponible" 404
  }
}
